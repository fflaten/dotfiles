{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "background": "#1d1d1d",
    "foreground": "black",
    "lightText": "white"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "style": "austin",
            "threshold": 500
          },
          "template": " <p:background>\udb86\udd9f</> {{ .FormattedMs }} ",
          "foreground": "p:foreground",
          "powerline_symbol": "\ue0b0",
          "background": "lightRed",
          "type": "executiontime",
          "style": "powerline"
        },
        {
          "template": " \uf0e7 ",
          "foreground": "p:foreground",
          "powerline_symbol": "\ue0b0",
          "background": "yellow",
          "type": "root",
          "style": "powerline"
        },
        {
          "template": "{{ if .Error }}❌{{ end }}",
          "type": "status",
          "style": "plain"
        },
        {
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "p:lightText",
          "powerline_symbol": "\ue0b0",
          "background": "darkGray",
          "type": "os",
          "style": "powerline"
        },
        {
          "options": {
            "cache_duration": "none"
          },
          "template": "{{ if .SSHSession }} \uf817 {{ .UserName }}@{{ .HostName }}<darkGray> \ue0b1</>{{ end }}",
          "foreground": "p:lightText",
          "powerline_symbol": "\ue0b0",
          "background": "p:background",
          "type": "session",
          "style": "powerline"
        },
        {
          "options": {
            "folder_icon": "📂",
            "hide_root_location": false,
            "home_icon": "🏠",
            "mapped_locations": {
              "~/Documents": "📄",
              "~/Git": "🚧",
              "~/OneDrive": " <blue>\uf8c9 </>"
            },
            "mapped_locations_enabled": true,
            "style": "short"
          },
          "template": "{{ .Path }}",
          "foreground": "cyan",
          "powerline_symbol": "\ue0b0",
          "background": "p:background",
          "type": "path",
          "style": "powerline"
        },
        {
          "template": "<darkGray>\ue0b1 </>{{ .Icon }}{{ if ne .Status \"stopped\" }}{{ .Artist }} - {{ .Track }}{{ end }}",
          "foreground": "lightGreen",
          "powerline_symbol": "\ue0b0",
          "background": "p:background",
          "type": "spotify",
          "style": "powerline"
        },
        {
          "template": "{{if ne .Env.TERM_PROGRAM \"vscode\"}}<darkGray>\ue0b1 </>{{ .HEAD }} {{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0}} \uf692 {{ .StashCount }}{{ end }}{{ if gt .WorktreeCount 0}} \uf1bb {{ .WorktreeCount }}{{ end }} {{ end }}",
          "foreground": "lightYellow",
          "powerline_symbol": "\ue0b0",
          "background": "p:background",
          "type": "git",
          "style": "powerline"
        },
        {
          "options": {
            "cache_duration": "none"
          },
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "foreground": "p:foreground",
          "powerline_symbol": "\ue0b0",
          "background": "magenta",
          "type": "python",
          "style": "powerline"
        },
        {
          "options": {
            "cache_duration": "none"
          },
          "cache": {},
          "template": "{{ if .Full }}<darkGray>\ue0b1</> \ue77f {{ .Full }} {{ end }}",
          "powerline_symbol": "\ue0b0",
          "background": "p:background",
          "type": "dotnet",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "alias": "Time",
          "template": "\uf43a {{ .CurrentDate | date .Format }}",
          "foreground": "p:lightText",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "cache_duration": "none"
          },
          "template": "\u276f",
          "foreground": "lightGreen",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
